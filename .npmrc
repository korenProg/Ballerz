# @react-native-community/datetimepicker lists react-native-windows as an
# optional peer, and npm otherwise tries to satisfy that package's own
# react-native ^0.85 peer against the SDK's newer react-native, failing with
# ERESOLVE. Ballerz does not target Windows, so skip optional-peer resolution.
legacy-peer-deps=true

# Do not resolve package versions published less than 7 days ago (npm >= 11.10;
# older npm ignores this). Guards against freshly published malicious releases.
min-release-age=7
